data/training/images/
data/training/labels/
data/training/annotations/*.json

# Delineation data
data/delineation/images/
data/delineation/masks/
data/delineation/delineated/
data/delineation/temp/

# Legacy data dirs (keep for compat)
data/raw/
data/processed/
data/output/

# Keep gitkeep and README
!data/**/.gitkeep
!data/**/README.md

# Model weights
*.pth
*.pt
!requirements*.txt

# ── Training outputs ────────────────────────────────────────
output_detectron2/
farm_fields_seg/
mlruns/
runs/
wandb/
lightning_logs/

